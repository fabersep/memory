{
  "name": "@fabersep/memory",
  "version": "0.1.1",
  "private": false,
  "description": "Prefix-cache-first, Git-backed Markdown memory MCP server, pre-memory staging, and import CLI for AI coding agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabersep/memory.git"
  },
  "homepage": "https://github.com/fabersep/memory#readme",
  "bugs": {
    "url": "https://github.com/fabersep/memory/issues"
  },
  "keywords": [
    "fabersep",
    "ai-agents",
    "memory",
    "mcp",
    "prompt-caching",
    "markdown",
    "git"
  ],
  "type": "module",
  "bin": {
    "faber-memory": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "faber-memory": "node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.8.3"
  }
}
